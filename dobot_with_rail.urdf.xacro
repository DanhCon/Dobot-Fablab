<?xml version="1.0" encoding="utf-8"?>
<!-- =================================================================================== -->
<!-- |    DOBOT MAGICIAN WITH SLIDING RAIL KIT - FULL SYSTEM XACRO MODEL               | -->
<!-- |    Combines Dobot Magician 4-DOF Robot Arm + 1-DOF Prismatic Linear Rail (L)    | -->
<!-- |    Total Degrees of Freedom: 5 DOF (Rail L + J1 + J2 + J3 + J4)                 | -->
<!-- =================================================================================== -->
<robot name="dobot_with_rail" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== CONSTANTS & PHYSICAL DIMENSIONS ==================== -->
  <xacro:property name="PI" value="3.1415926535897931"/>
  <xacro:property name="L1_BASE_HEIGHT" value="0.138"/>   <!-- 138 mm from base bottom to J2 axis -->
  <xacro:property name="L2_REAR_ARM"    value="0.135"/>   <!-- 135 mm upper arm length -->
  <xacro:property name="L3_FOREARM"     value="0.147"/>   <!-- 147 mm forearm length -->
  <xacro:property name="L4_WRIST"       value="0.059"/>   <!-- 59 mm wrist offset -->
  <xacro:property name="RAIL_TRAVEL"    value="1.000"/>   <!-- 1000 mm stroke -->

  <!-- ==================== COLOR PALETTE ==================== -->
  <material name="mat_rail_silver">
    <color rgba="0.75 0.78 0.82 1.0"/>
  </material>
  <material name="mat_steel_chrome">
    <color rgba="0.92 0.94 0.96 1.0"/>
  </material>
  <material name="mat_dobot_white">
    <color rgba="0.94 0.95 0.96 1.0"/>
  </material>
  <material name="mat_dobot_black">
    <color rgba="0.14 0.16 0.18 1.0"/>
  </material>
  <material name="mat_dobot_blue">
    <color rgba="0.094 0.392 0.671 1.0"/>
  </material>

  <!-- ==================== RAIL BASE LINK ==================== -->
  <link name="rail_base_link">
    <visual>
      <origin xyz="0 0 0.013" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 1.120 0.026"/>
      </geometry>
      <material name="mat_rail_silver"/>
    </visual>
    <!-- Dual linear chrome rods (12mm dia) -->
    <visual>
      <origin xyz="0.045 0 0.028" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="1.100"/>
      </geometry>
      <material name="mat_steel_chrome"/>
    </visual>
    <visual>
      <origin xyz="-0.045 0 0.028" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="1.100"/>
      </geometry>
      <material name="mat_steel_chrome"/>
    </visual>
    <!-- Stepper Motor Enclosure -->
    <visual>
      <origin xyz="0 -0.535 0.030" rpy="0 0 0"/>
      <geometry>
        <box size="0.110 0.070 0.050"/>
      </geometry>
      <material name="mat_dobot_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="0.160 1.140 0.050"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="4.85"/>
      <inertia ixx="0.508" ixy="0.0" ixz="0.0" iyy="0.012" iyz="0.0" izz="0.518"/>
    </inertial>
  </link>

  <!-- ==================== RAIL PRISMATIC JOINT (L-AXIS) ==================== -->
  <joint name="rail_joint" type="prismatic">
    <parent link="rail_base_link"/>
    <child link="rail_carriage_link"/>
    <origin xyz="0 -0.500 0.026" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="${RAIL_TRAVEL}" effort="150.0" velocity="0.08"/>
    <dynamics damping="15.0" friction="5.0"/>
  </joint>

  <!-- ==================== CARRIAGE LINK ==================== -->
  <link name="rail_carriage_link">
    <visual>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry>
        <box size="0.170 0.170 0.016"/>
      </geometry>
      <material name="mat_dobot_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry>
        <box size="0.170 0.170 0.016"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <mass value="0.95"/>
      <inertia ixx="0.0024" ixy="0.0" ixz="0.0" iyy="0.0024" iyz="0.0" izz="0.0046"/>
    </inertial>
  </link>

  <!-- ==================== DOBOT ROBOT BASE ATTACHMENT ==================== -->
  <joint name="dobot_base_joint" type="fixed">
    <parent link="rail_carriage_link"/>
    <child link="dobot_base_link"/>
    <origin xyz="0 0 0.016" rpy="0 0 0"/>
  </joint>

  <!-- 1. DOBOT BASE LINK (Chân đế trắng) -->
  <link name="dobot_base_link">
    <visual>
      <origin xyz="0 0 0.024" rpy="0 0 0"/>
      <geometry>
        <box size="0.158 0.158 0.048"/>
      </geometry>
      <material name="mat_dobot_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.067" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.042"/>
      </geometry>
      <material name="mat_dobot_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.080" length="0.090"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="1.20"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <!-- 2. JOINT 1 (Trục xoay thân đế: -90° to +90°) -->
  <joint name="dobot_joint_1" type="revolute">
    <parent link="dobot_base_link"/>
    <child link="dobot_link_1"/>
    <origin xyz="0 0 0.088" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${PI/2}" upper="${PI/2}" effort="10.0" velocity="5.5"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="dobot_link_1">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.056" length="0.050"/>
      </geometry>
      <material name="mat_dobot_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.056" length="0.050"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.85"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- 3. JOINT 2 (Trục vai / Cánh tay sau: 0° to 85°) -->
  <joint name="dobot_joint_2" type="revolute">
    <parent link="dobot_link_1"/>
    <child link="dobot_link_2"/>
    <origin xyz="0 0 0.050" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="${85 * PI / 180}" effort="12.0" velocity="5.5"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="dobot_link_2">
    <visual>
      <origin xyz="0 0 ${L2_REAR_ARM/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.040 ${L2_REAR_ARM}"/>
      </geometry>
      <material name="mat_dobot_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L2_REAR_ARM/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.045 ${L2_REAR_ARM}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${L2_REAR_ARM/2}" rpy="0 0 0"/>
      <mass value="0.75"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.0003"/>
    </inertial>
  </link>

  <!-- 4. JOINT 3 (Trục khuỷu / Cẳng tay trước: -10° to 90°) -->
  <joint name="dobot_joint_3" type="revolute">
    <parent link="dobot_link_2"/>
    <child link="dobot_link_3"/>
    <origin xyz="0 0 ${L2_REAR_ARM}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${10 * PI / 180}" upper="${PI/2}" effort="10.0" velocity="5.5"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="dobot_link_3">
    <visual>
      <origin xyz="${L3_FOREARM/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${L3_FOREARM} 0.036 0.024"/>
      </geometry>
      <material name="mat_dobot_black"/>
    </visual>
    <collision>
      <origin xyz="${L3_FOREARM/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${L3_FOREARM} 0.036 0.024"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${L3_FOREARM/2} 0 0" rpy="0 0 0"/>
      <mass value="0.65"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0012" iyz="0.0" izz="0.0012"/>
    </inertial>
  </link>

  <!-- 5. JOINT 4 (Khớp cổ tay / Động cơ R quay đầu hút: -90° to +90°) -->
  <joint name="dobot_joint_4" type="revolute">
    <parent link="dobot_link_3"/>
    <child link="dobot_link_4"/>
    <origin xyz="${L3_FOREARM} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${PI/2}" upper="${PI/2}" effort="5.0" velocity="8.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="dobot_link_4">
    <visual>
      <origin xyz="${L4_WRIST/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${L4_WRIST} 0.028 0.032"/>
      </geometry>
      <material name="mat_dobot_black"/>
    </visual>
    <inertial>
      <origin xyz="${L4_WRIST/2} 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- 6. END EFFECTOR (Giác hút khí nén / Suction Cup TCP) -->
  <joint name="dobot_suction_joint" type="fixed">
    <parent link="dobot_link_4"/>
    <child link="dobot_end_effector"/>
    <origin xyz="${L4_WRIST} 0 -0.0595" rpy="0 0 0"/>
  </joint>

  <link name="dobot_end_effector">
    <visual>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.010" length="0.055"/>
      </geometry>
      <material name="mat_steel_chrome"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.003" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.006"/>
      </geometry>
      <material name="mat_dobot_blue"/>
    </visual>
  </link>

</robot>
